_loxicmd_create_cert()
{
    last_command="loxicmd_create_cert"

    command_aliases=()

    commands=()

    flags=()
    two_word_flags=()
    local_nonpersistent_flags=()
    flags_with_completion=()
    flags_completion=()

    flags+=("--cert-file=")
    two_word_flags+=("--cert-file")
    local_nonpersistent_flags+=("--cert-file")
    local_nonpersistent_flags+=("--cert-file=")
    flags+=("--cert-id=")
    two_word_flags+=("--cert-id")
    local_nonpersistent_flags+=("--cert-id")
    local_nonpersistent_flags+=("--cert-id=")
