    local_nonpersistent_flags+=("--ip=")
    local_nonpersistent_flags+=("-i")
    flags+=("--ipv4route")
    flags+=("-r")
    local_nonpersistent_flags+=("--ipv4route")
    local_nonpersistent_flags+=("-r")
    flags+=("--lb=")
    two_word_flags+=("--lb")
    two_word_flags+=("-l")
    local_nonpersistent_flags+=("--lb")
    local_nonpersistent_flags+=("--lb=")
    local_nonpersistent_flags+=("-l")
    flags+=("--per-intf=")
    two_word_flags+=("--per-intf")
    local_nonpersistent_flags+=("--per-intf")
    local_nonpersistent_flags+=("--per-intf=")
    flags+=("--session=")
    two_word_flags+=("--session")
    local_nonpersistent_flags+=("--session")
    local_nonpersistent_flags+=("--session=")
    flags+=("--ulcl=")
    two_word_flags+=("--ulcl")
    local_nonpersistent_flags+=("--ulcl")
    local_nonpersistent_flags+=("--ulcl=")
    flags+=("--apiserver=")
    two_word_flags+=("--apiserver")
    two_word_flags+=("-s")
    flags+=("--bearer")
    flags+=("--cacert=")
    two_word_flags+=("--cacert")
    flags+=("--cert=")
    two_word_flags+=("--cert")
    flags+=("--insecure")
    flags+=("-k")
    flags+=("--key=")
    two_word_flags+=("--key")
    flags+=("--output=")
    two_word_flags+=("--output")
    two_word_flags+=("-o")
    flags+=("--port=")
    two_word_flags+=("--port")
    two_word_flags+=("-p")
    flags+=("--protocol=")
    two_word_flags+=("--protocol")
    flags+=("--timeout=")
    two_word_flags+=("--timeout")
    two_word_flags+=("-t")
    flags+=("--token=")
    two_word_flags+=("--token")

    must_have_one_flag=()
    must_have_one_noun=()
    noun_aliases=()
}

