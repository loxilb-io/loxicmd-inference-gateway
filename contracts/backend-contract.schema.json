{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loxilb.io/schemas/appliance-backend/v1/backend-contract.schema.json",
  "title": "BackendContract CLI-WP00 candidate",
  "description": "Exact CONSERVATIVE_V1 handshake candidate. Command order, readOnly values, and capability arrays are contract data, not hints.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "backendVersion", "productRelease", "schemaVersion", "commands"],
  "properties": {
    "apiVersion": {"const": "loxilb.io/appliance-backend/v1"},
    "kind": {"const": "BackendContract"},
    "backendVersion": {"type": "string", "minLength": 1},
    "productRelease": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "appliance-backend-payload/v1"},
    "commands": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "prefixItems": [
        {"$ref": "#/$defs/status"},
        {"$ref": "#/$defs/networkValidate"},
        {"$ref": "#/$defs/publicAddressConfigure"},
        {"$ref": "#/$defs/gatewayRegisterLocal"},
        {"$ref": "#/$defs/credentialsBootstrap"},
        {"$ref": "#/$defs/diagnosticsCreate"},
        {"$ref": "#/$defs/logs"},
        {"$ref": "#/$defs/backupKeyCreate"},
        {"$ref": "#/$defs/backupCreate"},
        {"$ref": "#/$defs/backupVerify"}
      ],
      "items": false
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "readOnly", "capabilities"],
      "properties": {
        "name": {"type": "string"},
        "readOnly": {"type": "boolean"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["json-output", "no-restart", "secret-stdin", "redaction", "explicit-output", "bounded-window", "key-file", "operation-receipt", "console-only"]}}
      }
    },
    "status": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "status"}, "readOnly": {"const": true}, "capabilities": {"const": ["json-output"]}}}]},
    "networkValidate": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "network validate"}, "readOnly": {"const": true}, "capabilities": {"const": ["json-output"]}}}]},
    "publicAddressConfigure": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "public-address configure"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "no-restart", "operation-receipt"]}}}]},
    "gatewayRegisterLocal": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "gateway register-local"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "secret-stdin", "operation-receipt"]}}}]},
    "credentialsBootstrap": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "credentials bootstrap"}, "readOnly": {"const": false}, "capabilities": {"const": ["console-only"]}}}]},
    "diagnosticsCreate": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "diagnostics create"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "redaction", "explicit-output", "operation-receipt"]}}}]},
    "logs": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "logs"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "redaction", "bounded-window"]}}}]},
    "backupKeyCreate": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "backup key-create"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "key-file", "operation-receipt"]}}}]},
    "backupCreate": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "backup create"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "key-file", "operation-receipt"]}}}]},
    "backupVerify": {"allOf": [{"$ref": "#/$defs/command"}, {"properties": {"name": {"const": "backup verify"}, "readOnly": {"const": false}, "capabilities": {"const": ["json-output", "key-file"]}}}]}
  }
}
