{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://loxilb.io/schemas/appliance-backend/v1/lifecycle/update-status.schema.json","title":"update status payload","type":"object","additionalProperties":false,"required":["schemaVersion","command","operationId","status","phase","observedAt"],"properties":{"schemaVersion":{"const":"appliance-backend-payload/v1"},"command":{"const":"update status"},"operationId":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"status":{"enum":["PENDING","RUNNING","SUCCEEDED","FAILED","ROLLED_BACK","PARTIAL"]},"phase":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"observedAt":{"type":"string","format":"date-time","pattern":"Z$"}}}
